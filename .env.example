NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$GENERATED_SALT_HEX$GENERATED_HASH_HEX
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=configure-in-deployment-secrets
SMTP_FROM="Intelligence Systems <no-reply@example.com>"
APPLICATION_NOTIFICATION_TO=internships@intelligencesystems.in
